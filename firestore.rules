rules_version = '2';

// ===============================================================
// Assumed Data Model (P1: 가입 · 로그인 · 학원 탐색)
// ===============================================================
//
// Collection: users            Document ID: Firebase Auth uid
//   - role: string (required, immutable) 'parent' | 'staff' | 'student'
//   - loginId: string (required, immutable) 영소문자·숫자 4–20, 또는 한글 아이디의 'k.' + UTF-8 16진수(앱 AuthService.keyOf)
//   - name: string (required, 1–30) 학부모 닉네임 / 관계자 · 학생 실명
//   - area: string (required, '' 또는 동안구 권역 4개 중 하나)
//   - plus: bool (required, 생성 때 false. 테스트 결제로 본인이 켜고 끈다)
//   - createdAt: timestamp (required, immutable, 서버 시각)
//   - 학부모: kids: list (≤5, 각 항목 map), interests: list (≤10)
//   - 관계자: academyId: string (immutable, ≤10), position: string (≤10), verified: bool (immutable, 생성 때 false — 운영자만 콘솔에서 켬)
//   - 학생: grade: string (≤3), parentUid: string | null (immutable), academyIds: list (≤10)
//   * 자녀 정보가 들어 있어 본인만 읽는다. 다른 사람에게 보여 줄 이름은 각 글 · 상담 문서에 따로 적는다.
//   * 아이디 계정만 만들 수 있다(임시 · 익명 계정 불가). loginId 는 로그인 토큰의 이메일(<loginId>@alumalum.app)과 같아야 한다.
//   * 학생이 parentUid 를 적으려면 private/info.linkCode 에 그 보호자의 연결 코드를 함께 적어야 한다(코드를 아는 사람만 연결).
//
// Collection: users/{uid}/private   Document ID: 'info'
//   - phone: string (≤20), email: string (≤100, 빈 문자열 허용), agreed: list (≤5)
//   - signaturePng: bytes (≤200KB), linkCode: string (선택, 숫자 6자리 — 학부모는 내 코드, 학생은 연결한 보호자 코드), signedAt: timestamp (서버 시각)
//   * 본인만 읽기 · 만들기. 수정 · 삭제 불가.
//
// Collection: linkCodes        Document ID: 숫자 6자리
//   - parentUid: string (= 만든 사람 uid), parentName: string (1–30)
//   * 코드를 아는 사람만 1건 조회(get). 목록 조회 불가. 만든 뒤 수정 · 삭제 불가.
//   * 학부모 가입 배치 안에서만, 그 배치의 private/info.linkCode 와 같은 코드로 한 번 만든다(코드 대량 선점 방지).
//
// Collection: academies        Document ID: 학원ID (H001…)
//   * 등록 도구(서비스 계정)만 쓴다. 로그인한 사람(가입 중 임시 계정 포함)은 읽기만.
//
// Collection: academies/{academyId}/classes   Document ID: 자동
//   - grade: string (1–4) 대상 학년, name: string (1–20) 반 이름, subject: string (1–10)
//   - perWeek: int (1–7) 주당 수업 횟수, minutes: int (10–600) 1회 수업 시간, fee: int (0–10,000,000) 월 수강료, cap: int (1–200) 정원
//   - updatedAt: timestamp (서버 시각)
//   * 로그인한 사람은 읽기. 그 학원을 소속으로 가입한 관계자만 만들고 고치고 지운다.
//
// Collection: academies_meta   * 외부 후기 · 조사 메모. 앱에서 읽기 · 쓰기 불가.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 가입 화면의 임시(익명) 계정이 아닌, 아이디 · 비밀번호로 전환을 마친 계정
    function isFullAccount() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function privatePath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/info;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isList(v, maxSize) {
      return v is list && v.size() <= maxSize;
    }

    function optStr(data, field, maxLen) {
      return !(field in data) || data[field] == null || isStr(data[field], 0, maxLen);
    }

    function optList(data, field, maxSize) {
      return !(field in data) || isList(data[field], maxSize);
    }

    function isIntIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function isArea(v) {
      return v in ['', '평촌 학원가', '호계', '관양·인덕원', '비산'];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return hasOnlyAllowedFields(['role', 'loginId', 'name', 'area', 'plus', 'createdAt',
                                   'kids', 'interests', 'academyId', 'position', 'verified',
                                   'grade', 'parentUid', 'academyIds']) &&
             hasRequiredFields(['role', 'loginId', 'name', 'area', 'plus', 'createdAt']) &&
             data.role in ['parent', 'staff', 'student'] &&
             isStr(data.loginId, 4, 64) && data.loginId.matches('^([a-z0-9]{4,20}|k[.]([0-9a-f]{2}){3,30})$') &&
             isStr(data.name, 1, 30) &&
             isArea(data.area) &&
             data.plus is bool &&
             data.createdAt is timestamp &&
             optList(data, 'kids', 5) &&
             optList(data, 'interests', 10) &&
             optList(data, 'academyIds', 10) &&
             optStr(data, 'academyId', 10) &&
             optStr(data, 'position', 10) &&
             optStr(data, 'grade', 3) &&
             optStr(data, 'parentUid', 128) &&
             (!('verified' in data) || data.verified is bool) &&
             // 역할에 맞지 않는 필드는 받지 않는다
             (data.role == 'staff' || !data.keys().hasAny(['academyId', 'position', 'verified'])) &&
             (data.role == 'parent' || !data.keys().hasAny(['kids', 'interests'])) &&
             (data.role == 'student' || !data.keys().hasAny(['grade', 'parentUid', 'academyIds'])) &&
             (data.role != 'staff' || (data.academyId is string && data.academyId.size() > 0));
    }

    function isValidPrivate(data) {
      return hasOnlyAllowedFields(['phone', 'email', 'agreed', 'signaturePng', 'linkCode', 'signedAt']) &&
             hasRequiredFields(['phone', 'email', 'agreed', 'signaturePng', 'signedAt']) &&
             isStr(data.phone, 0, 20) &&
             isStr(data.email, 0, 100) &&
             isList(data.agreed, 5) &&
             data.signaturePng is bytes && data.signaturePng.size() <= 200000 &&
             (!('linkCode' in data) || (data.linkCode is string && data.linkCode.matches('^[0-9]{6}$'))) &&
             data.signedAt == request.time;
    }

    // 학생이 보호자를 적었다면, 같은 배치의 private/info 에 그 보호자의 연결 코드가 있어야 한다.
    function isValidParentLink(userId, data) {
      return data.get('parentUid', null) == null ||
             (getAfter(privatePath(userId)).data.get('linkCode', '') != '' &&
              get(/databases/$(database)/documents/linkCodes/$(getAfter(privatePath(userId)).data.linkCode)).data.parentUid == data.parentUid);
    }

    function isValidClass(data) {
      return hasOnlyAllowedFields(['grade', 'name', 'subject', 'perWeek', 'minutes', 'fee', 'cap', 'updatedAt']) &&
             hasRequiredFields(['grade', 'name', 'subject', 'perWeek', 'minutes', 'fee', 'cap', 'updatedAt']) &&
             isStr(data.grade, 1, 4) &&
             isStr(data.name, 1, 20) &&
             isStr(data.subject, 1, 10) &&
             isIntIn(data.perWeek, 1, 7) &&
             isIntIn(data.minutes, 10, 600) &&
             isIntIn(data.fee, 0, 10000000) &&
             isIntIn(data.cap, 1, 200) &&
             data.updatedAt == request.time;
    }

    // 그 학원을 소속으로 가입한 관계자
    function isStaffOf(academyId) {
      return isFullAccount() &&
             get(userPath(request.auth.uid)).data.role == 'staff' &&
             get(userPath(request.auth.uid)).data.academyId == academyId;
    }

    function isValidLinkCode(code, data) {
      return hasOnlyAllowedFields(['parentUid', 'parentName']) &&
             hasRequiredFields(['parentUid', 'parentName']) &&
             code.matches('^[0-9]{6}$') &&
             data.parentUid == request.auth.uid &&
             isStr(data.parentName, 1, 30);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // 회원: 본인만 읽고 쓴다. 역할 · 아이디 · 소속 학원 · 서류 확인 · 보호자 연결은 만든 뒤 바꿀 수 없다.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isFullAccount() &&
                       request.auth.token.email == request.resource.data.loginId + '@alumalum.app' &&
                       isValidUser(request.resource.data) &&
                       isValidParentLink(userId, request.resource.data) &&
                       request.resource.data.plus == false &&
                       request.resource.data.get('verified', false) == false &&
                       request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       areImmutableFieldsUnchanged(['role', 'loginId', 'createdAt', 'academyId', 'verified', 'parentUid']);
      allow delete: if false;

      // 휴대폰 · 이메일 · 서명 · 자녀 연결 코드: 본인만, 한 번만 만든다.
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isFullAccount() && docId == 'info' && isValidPrivate(request.resource.data);
        allow update, delete: if false;
      }
    }

    // 자녀 연결 코드: 코드를 아는 사람만 조회. 학부모 본인이 가입 때 프로필과 같은 배치로 만든다.
    match /linkCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isFullAccount() &&
                       isValidLinkCode(code, request.resource.data) &&
                       !exists(userPath(request.auth.uid)) &&
                       getAfter(userPath(request.auth.uid)).data.role == 'parent' &&
                       getAfter(userPath(request.auth.uid)).data.name == request.resource.data.parentName &&
                       getAfter(privatePath(request.auth.uid)).data.get('linkCode', '') == code;
      allow update, delete: if false;
    }

    // 학원 목록: 등록 도구만 쓴다.
    match /academies/{academyId} {
      allow read: if isAuthenticated();
      allow write: if false;

      // 반별 수강료: 학원 관계자가 직접 등록한다.
      match /classes/{classId} {
        allow read: if isAuthenticated();
        allow create, update: if isStaffOf(academyId) && isValidClass(request.resource.data);
        allow delete: if isStaffOf(academyId);
      }
    }

    // 그 밖의 모든 경로(academies_meta 포함)는 기본 차단.
  }
}
